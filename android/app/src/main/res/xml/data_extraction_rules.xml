<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup Android (API 31+) — mêmes règles que backup_rules.xml, pour la
  sauvegarde cloud ET le transfert direct entre appareils.
  Voir docs/technical/auto-backup-android.md
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <exclude domain="file" path="photos/" />
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <exclude domain="file" path="photos/" />
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
